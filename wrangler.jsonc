{
  // Static-assets-only Worker. Astro builds the site into ./dist, and this Worker
  // just serves those files. "name" must match the Worker created in the Cloudflare
  // dashboard, otherwise `wrangler deploy` will create a second Worker.
  "name": "tangata-web",
  "compatibility_date": "2026-08-28",
  "assets": {
    "directory": "./dist",
    // Astro generates a real 404.html, so serve that for unknown paths.
    "not_found_handling": "404-page"
  }
}
