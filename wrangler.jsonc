{
  // Static-assets-only Worker: no server code, just the demo site in ./public
  // NOTE: "name" must match the Worker you created in the Cloudflare dashboard,
  // otherwise `wrangler deploy` will create a second Worker under this name.
  "name": "tangata-web",
  "compatibility_date": "2026-08-28",
  "assets": {
    "directory": "./public",
    // One-page demo: send unknown paths to index.html rather than a 404
    "not_found_handling": "single-page-application"
  }
}
