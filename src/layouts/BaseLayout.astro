---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE, baseGraph } from '../lib/site.mjs';

interface Props {
  title?: string;
  metaTitle?: string;
  description?: string;
  /** Page type for Open Graph. Use 'article' for blog posts. */
  type?: 'website' | 'article';
  /** Path or absolute URL to a 1200x630 share image. Defaults to the site image. */
  image?: string;
  /** ISO date — article pages only. */
  publishedTime?: string;
  /** ISO date — article pages only. */
  modifiedTime?: string;
  /** Keep this page out of search indexes (e.g. 404). */
  noindex?: boolean;
  /** Extra JSON-LD nodes to merge into the page's @graph. */
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  metaTitle,
  description = SITE.description,
  type = 'website',
  image = SITE.ogImage,
  publishedTime,
  modifiedTime,
  noindex = false,
  jsonLd = [],
} = Astro.props;

const siteName = SITE.name;
const fullTitle = metaTitle ?? (title ? `${title} — ${siteName}` : `${siteName} — EMDR & Counselling in Bristol`);

const base = Astro.site ?? new URL(SITE.url);
const canonical = new URL(Astro.url.pathname, base);
const ogImage = new URL(image, base).href;

const isDefaultImage = image === SITE.ogImage;

const graph = [...baseGraph(base.href.replace(/\/$/, '')), ...jsonLd];
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      noindex ? (
        <meta name="robots" content="noindex, follow" />
      ) : (
        <meta name="robots" content="index, follow, max-image-preview:large" />
      )
    }
    <meta name="author" content={SITE.founder.name} />
    <meta name="theme-color" content="#123f4a" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={fullTitle} />
    {
      isDefaultImage && (
        <>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {type === 'article' && <meta property="article:author" content={SITE.founder.name} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <JsonLd schema={graph} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Nav />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      document.addEventListener('click', (event) => {
        const trigger = event.target.closest('.youtube-facade');
        if (!trigger || trigger.dataset.loaded === 'true') return;

        const id = trigger.dataset.videoId;
        const title = trigger.dataset.videoTitle;
        if (!id || !title) return;

        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;
        iframe.title = title;
        iframe.loading = 'lazy';
        iframe.setAttribute('frameborder', '0');
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.allowFullscreen = true;
        iframe.tabIndex = 0;

        trigger.replaceWith(iframe);
        iframe.focus();
      });
    </script>
  </body>
</html>
