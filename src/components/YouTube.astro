---
import { youTubeId } from '../lib/youtube.mjs';

interface Props {
  url: string;
  title?: string;
  poster?: string;
}

const { url, title = 'YouTube video player', poster = '/og-default.png' } = Astro.props;
const id = youTubeId(url);
---
{
  id && (
    <div class="video-embed youtube-shell">
      <button class="youtube-facade" type="button" data-video-id={id} data-video-title={title} aria-label={`Play video: ${title}`}>
        <img src={poster} alt="" class="youtube-poster" />
        <span class="youtube-overlay" aria-hidden="true"></span>
        <span class="youtube-play">Play video</span>
        <span class="youtube-note">Playing this video loads content from YouTube.</span>
      </button>
    </div>
  )
}
