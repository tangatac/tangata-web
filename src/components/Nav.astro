---
const path = Astro.url.pathname;
const isBlog = path.startsWith('/blog');
---
<header class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href="/" aria-label="Tangata Counselling home">
      <svg viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="48" fill="#1c6b7d"/><path d="M50,16 A34,34 0 1 1 16,50 A25,25 0 1 1 50,25 A15,15 0 1 1 37,44" fill="none" stroke="#cfe6ec" stroke-width="6" stroke-linecap="round"/></svg>
      <div class="brand-text">Tangata<small>Counselling</small></div>
    </a>
    <nav class="links">
      <a class:list={['nav-link', { active: path === '/' }]} href="/">Home</a>
      <a class="nav-link" href="/#emdr">EMDR</a>
      <a class="nav-link" href="/#howiwork">Counselling</a>
      <a class="nav-link" href="/#about">About</a>
      <a class:list={['nav-link', { active: isBlog }]} href="/blog">Blog</a>
      <a class="btn btn-primary" href="/#contact">Book a free chat</a>
    </nav>
  </div>
</header>
