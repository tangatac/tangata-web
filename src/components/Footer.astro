const links = SOCIAL_LINKS.filter((s) => ICONS[s.label]);
---
<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <img src="/images/tangata-blue-swirl-only.png" alt="Tangata Counselling emblem" class="foot-brand-logo" />
        <p>Integrative counselling &amp; EMDR therapy in Bristol. A safe, confidential space to be heard.</p>
      </div>
      <div>
        <h4>Explore</h4>
        <ul class="foot-links">
          <li><a href="/#emdr">EMDR therapy</a></li>
          <li><a href="/#howiwork">How I work</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/#contact">Contact</a></li>
          <li><a href="/accessibility/">Accessibility</a></li>
        </ul>
      </div>
      <div>
        <h4>Get in touch</h4>
        <ul class="foot-links">
          <li><a href="mailto:nick@tangata-counselling.co.uk">nick@tangata-counselling.co.uk</a></li>
          <li><a href="tel:07988136267">07988 136267</a></li>
          <li>Fishponds, Bristol BS16</li>
        </ul>
        {
          links.length > 0 && (
            <ul class="foot-social" aria-label="Social links">
              {links.map((s) => (
                <li>
                  <a
                    href={s.href}
                    aria-label={s.label}
                    rel={s.href === '#' ? undefined : 'me noopener'}
                    target={s.href === '#' ? undefined : '_blank'}
                  >
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path fill="currentColor" d={ICONS[s.label]} />
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
    <div class="foot-bar">
      <span>© {year} Tangata Counselling. All rights reserved.</span>
      <span>BACP registered member 375989 · <a href="/privacy/">Privacy &amp; cookies</a></span>
    </div>
  </div>
</footer>
