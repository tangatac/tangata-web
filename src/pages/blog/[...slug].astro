---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../lib/format.mjs';
import { youTubeId } from '../../lib/youtube.mjs';
import { SITE, absoluteUrl, breadcrumbSchema } from '../../lib/site.mjs';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
  );
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      // newer = earlier in the list, older = later
      newer: posts[i - 1] ?? null,
      older: posts[i + 1] ?? null,
    },
  }));
}

const { post, newer, older } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const { title, description, date, updated, category, author, image, youtube } = post.data;
const readTime = remarkPluginFrontmatter.minutesRead as string | undefined;
const heroVideoId = youtube ? youTubeId(youtube) : null;

const url = absoluteUrl(`/blog/${post.id}/`);
const published = date.toISOString();
const modified = (updated ?? date).toISOString();
const shareImage = image ?? SITE.ogImage;

const blogPosting = {
  '@type': 'BlogPosting',
  '@id': `${url}#article`,
  headline: title,
  description,
  datePublished: published,
  dateModified: modified,
  url,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  image: absoluteUrl(shareImage),
  articleSection: category,
  inLanguage: 'en-GB',
  author: { '@type': 'Person', name: author, '@id': `${SITE.url}/#nick` },
  publisher: { '@id': `${SITE.url}/#practice` },
  isPartOf: { '@id': `${SITE.url}/blog/#blog` },
};

const breadcrumbs = breadcrumbSchema([
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog/' },
  { name: title, path: `/blog/${post.id}/` },
]);
---
<BaseLayout
  title={title}
  description={description}
  type="article"
  image={shareImage}
  publishedTime={published}
  modifiedTime={modified}
  jsonLd={[blogPosting, breadcrumbs]}
>
  <section class="article-hero">
    <div class="wrap">
      <a class="back" href="/blog/">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M15 18l-6-6 6-6"/></svg>
        Back to the blog
      </a>
      <div class="art-meta">
        <span class="chip" style="margin:0;">{category}</span>
        <span>{formatDate(date)}</span>
        {readTime && <span>· {readTime}</span>}
        <span>· by {author}</span>
      </div>
      <h1>{title}</h1>
    </div>
  </section>

  <article class="article-body">
    {
      heroVideoId && (
        <div class="video-embed">
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${heroVideoId}`}
            title={title}
            loading="lazy"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          />
        </div>
      )
    }

    <Content />

    <div class="author-box">
      <div class="av" aria-hidden="true"></div>
      <div>
        <b>{author}</b>
        <p>BACP-accredited counsellor and EMDR therapist working in Fishponds and central Bristol.</p>
      </div>
    </div>

    <div class="article-cta">
      <h3>Have a question?</h3>
      <p>Book a free, no-obligation 15-minute chat and we'll talk it through.</p>
      <a class="btn btn-primary" href="/#contact">Book a free chat</a>
    </div>

    {
      (newer || older) && (
        <nav class="post-nav" aria-label="More posts">
          {older ? (
            <a class="post-nav-link prev" href={`/blog/${older.id}/`}>
              <span class="dir">← Older post</span>
              <span class="t">{older.data.title}</span>
            </a>
          ) : (
            <span />
          )}
          {newer ? (
            <a class="post-nav-link next" href={`/blog/${newer.id}/`}>
              <span class="dir">Newer post →</span>
              <span class="t">{newer.data.title}</span>
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }
  </article>
</BaseLayout>
