---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found">
  <section class="article-hero">
    <div class="wrap">
      <div class="eyebrow">404</div>
      <h1>We couldn't find that page</h1>
      <p style="color:var(--muted);max-width:34em;margin-top:8px;">
        The page may have moved. Try the <a href="/">home page</a> or the
        <a href="/blog">blog</a>.
      </p>
    </div>
  </section>
</BaseLayout>
